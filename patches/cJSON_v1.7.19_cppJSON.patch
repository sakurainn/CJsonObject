+/* create a number with an exact signed 64-bit integer value (this project extends cJSON) */
+CJSON_PUBLIC(cJSON *) cJSON_CreateInt64(int64_t num)
+{
+    cJSON *item = cJSON_New_Item(&global_hooks);
+    if(item)
+    {
+        item->type = cJSON_Number;
+        item->valueint = (int64_t)num;
+        item->valuedouble = (double)num;
+        item->sign = -1; /* signed integer */
+    }
+
+    return item;
+}
+
+/* create a number with an exact unsigned 64-bit integer value (this project extends cJSON) */
