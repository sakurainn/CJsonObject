 /* Render the number nicely from the given item into a string. */
+/* rewrite Ryu scientific output ("M.mmmEe", no terminator, len) into JSON
+ * fixed/scientific notation.  Returns the new length.  Always valid JSON. */
+static int cJSON_RyuFormatShortest(char* buf, int len)
+{
+    int i = 0;
+    int epos = len;
+    int exp = 0;
+    int start = (buf[0] == '-') ? 1 : 0;
+    char digits[32];
+    int vd = 0;            /* number of significant digits ('.' excluded) */
+    char out[32];
+    int ol = 0;
+
+    /* locate the exponent marker and parse the decimal exponent */
+    for (i = 0; i < len; i++)
+    {
+        if (buf[i] == 'E')
+        {
+            epos = i;
+            break;
+        }
+    }
+    if (epos < len)
+    {
+        int neg = 0;
+        for (i = epos + 1; i < len; i++)
+        {
+            if (buf[i] == '-')
+            {
+                neg = 1;
+            }
+            else
+            {
+                exp = exp * 10 + (buf[i] - '0');
+            }
+        }
+        if (neg)
+        {
+            exp = -exp;
+        }
+    }
+    /* collect significant digits */
+    for (i = start; i < epos; i++)
+    {
+        if (buf[i] != '.')
+        {
+            digits[vd++] = buf[i];
+        }
+    }
+    if (start)
+    {
+        out[ol++] = '-';
+    }
+
+    if ((exp >= -4) && (exp < 16))
+    {
+        /* fixed-point notation */
+        if (exp >= 0)
+        {
+            if (exp < vd - 1)
+            {
+                for (i = 0; i <= exp; i++)
+                {
+                    out[ol++] = digits[i];
+                }
+                out[ol++] = '.';
+                for (i = exp + 1; i < vd; i++)
+                {
+                    out[ol++] = digits[i];
+                }
+            }
+            else
+            {
+                for (i = 0; i < vd; i++)
+                {
+                    out[ol++] = digits[i];
+                }
+                for (i = 0; i < exp - (vd - 1); i++)
+                {
+                    out[ol++] = '0';
+                }
+            }
+        }
+        else
+        {
+            out[ol++] = '0';
+            out[ol++] = '.';
+            for (i = 0; i < -exp - 1; i++)
+            {
+                out[ol++] = '0';
+            }
+            for (i = 0; i < vd; i++)
+            {
+                out[ol++] = digits[i];
+            }
+        }
+    }
+    else
+    {
+        /* scientific notation, lowercase e */
+        out[ol++] = digits[0];
+        if (vd > 1)
+        {
+            out[ol++] = '.';
+            for (i = 1; i < vd; i++)
+            {
+                out[ol++] = digits[i];
+            }
+        }
+        out[ol++] = 'e';
+        if (exp < 0)
+        {
+            out[ol++] = '-';
+            exp = -exp;
+        }
+        {
+            char eb[8];
+            int el = 0;
+            if (exp == 0)
+            {
+                eb[el++] = '0';
+            }
+            while (exp > 0)
+            {
+                eb[el++] = (char)('0' + exp % 10);
+                exp /= 10;
+            }
+            for (i = el - 1; i >= 0; i--)
+            {
+                out[ol++] = eb[i];
+            }
+        }
+    }
+    memcpy(buf, out, (size_t)ol);
+    return ol;
+}
