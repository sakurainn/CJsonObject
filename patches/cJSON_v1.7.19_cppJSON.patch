+{
+    cJSON *item = cJSON_New_Item(&global_hooks);
+    if(item)
+    {
+        item->type = cJSON_Number;
+        item->valueint = (int64_t)num;
+        item->valuedouble = (double)num;
+        item->sign = 1; /* unsigned integer */
+    }
+
+    return item;
+}
